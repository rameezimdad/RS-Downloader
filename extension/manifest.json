{
  "manifest_version": 3,
  "name": "RS Downloader",
  "version": "1.0.7",
  "description": "Send videos, pictures and files to the RS Downloader app on this PC. By Rameez Scripts.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RS Downloader",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "bg.js"
  },
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "cookies",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "i18n.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
