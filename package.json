{
  "name": "rs-downloader",
  "productName": "RS Downloader",
  "version": "1.6.0",
  "private": true,
  "description": "RS Downloader: save videos and MP3 from YouTube, X, Instagram, TikTok and 1,800+ sites, by Rameez Scripts (rameezscripts.com)",
  "author": "Rameez Scripts <Contact@rameezscripts.com>",
  "homepage": "https://rameezscripts.com",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.5.1",
    "electron-updater": "6.8.12",
    "ffmpeg-static": "5.3.0",
    "tabulator-tables": "6.3.1"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.rameezscripts.rsdownloader",
    "productName": "RS Downloader",
    "copyright": "Copyright (c) 2026 Rameez Scripts",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "src/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/ui/icon.png",
      "executableName": "RS Downloader"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RS Downloader",
      "uninstallDisplayName": "RS Downloader",
      "deleteAppDataOnUninstall": false,
      "artifactName": "RS-Downloader-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rameezimdad",
        "repo": "RS-Downloader-Releases"
      }
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      },
      {
        "from": "engines",
        "to": "engines"
      }
    ]
  }
}
